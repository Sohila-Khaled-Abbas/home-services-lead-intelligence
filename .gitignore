# Generated extraction outputs: retain only the two existing November 4 baseline runs.
# New live responses can contain third-party contact details; review before publishing.
data/raw/*
!data/raw/osm_cairo_metro_20261104T231256Z.json
!data/raw/osm_cairo_metro_v2_20261104T232357Z.json

data/processed/*
